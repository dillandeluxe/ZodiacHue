<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Prismatic outer hue ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,22 A32,32 0 1,1 53.99,22 Z"
        android:strokeWidth="2.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="86"
                android:endY="86"
                android:startX="22"
                android:startY="22"
                android:type="linear">
                <item
                    android:color="#FFFBBF24"
                    android:offset="0.0" />
                <item
                    android:color="#FFFF6F61"
                    android:offset="0.33" />
                <item
                    android:color="#FF6B8AFF"
                    android:offset="0.68" />
                <item
                    android:color="#FF00BCD4"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle inner orbital ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,30 A24,24 0 1,1 53.99,30 Z"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="1.0" />

    <!-- Central luminous 4-point celestial star -->
    <path
        android:fillColor="#FFF8FAFF"
        android:pathData="M54,31 C55.6,45.5 62.5,52.4 77,54 C62.5,55.6 55.6,62.5 54,77 C52.4,62.5 45.5,55.6 31,54 C45.5,52.4 52.4,45.5 54,31 Z" />

    <!-- Subtle gold star accent dot at upper right orbit -->
    <path
        android:fillColor="#FFFBBF24"
        android:pathData="M77,31 A2.4,2.4 0 1,1 76.99,31 Z" />
</vector>
