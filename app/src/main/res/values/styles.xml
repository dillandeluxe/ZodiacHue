<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ListItemWhiteText" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CircularShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImage16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/cosmic_surface_solid</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/indigo_accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@drawable/card_cosmic_solid</item>
    </style>

    <style name="CosmicBottomSheetTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CosmicBottomSheetModal</item>
        <item name="colorSurface">@color/cosmic_surface_solid</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="CosmicBottomSheetModal" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/cosmic_surface_solid</item>
        <item name="shapeAppearanceOverlay">@style/BottomSheetCornerShape</item>
    </style>

    <style name="BottomSheetCornerShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="CosmicPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_primary_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <style name="CosmicSecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/btn_secondary_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
    </style>
</resources>
